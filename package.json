{
  "name": "my-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "dist": "npm run build && cross-env NODE_OPTIONS=--max-old-space-size=4096 electron-builder",
    "dist:win": "npm run build && cross-env NODE_OPTIONS=--max-old-space-size=4096 electron-builder --win",
    "dist:mac": "npm run build && cross-env NODE_OPTIONS=--max-old-space-size=4096 electron-builder --mac"
  },
  "description": "Automation Tool",
  "author": "Nguyen Minh Tien",
  "build": {
    "appId": "com.tien.mytool",
    "productName": "Automation Tool",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.map",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-Mac-${version}-${arch}.${ext}",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "electron/**/*",
      "**/node_modules/@xenova/transformers/**/*",
      "**/node_modules/onnxruntime-node/bin/**/*",
      "**/node_modules/ffmpeg-static/ffmpeg*",
      "**/node_modules/ffprobe-static/bin/**/*"
    ]
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.0",
    "electron-is-dev": "^3.0.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.20.0",
    "tailwindcss": "^4.1.16",
    "vite": "^8.0.4",
    "wait-on": "^9.0.4"
  }
}
